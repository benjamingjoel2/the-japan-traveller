---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.mjs';
import { humanDate } from '../lib/dates.mjs';
interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
---
<Base title={title} description={description} path={path} crumbs={[{ name: title, href: path }]}>
  <h1>{title}</h1>
  <dl class="meta">
    <div><dt>Effective</dt><dd><time datetime={site.legalEffectiveDate}>{humanDate(site.legalEffectiveDate)}</time></dd></div>
    <div><dt>Applies to</dt><dd>{site.domain}</dd></div>
  </dl>
  <div class="prose"><slot /></div>
</Base>
