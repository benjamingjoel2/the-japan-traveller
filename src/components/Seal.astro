---
// Site mark: indigo seal with a white ring and the character 日 (Japan/sun).
interface Props { class?: string }
const { class: cls = 'seal' } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" width="64" height="64" aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="31" fill="#1f3e9a" />
  <circle cx="32" cy="32" r="27" fill="none" stroke="#fff" stroke-width="1.5" />
  <circle cx="32" cy="32" r="23.5" fill="none" stroke="#c23b27" stroke-width="1" />
  <text x="32" y="43.5" text-anchor="middle" font-family="'Shippori Mincho', 'Hiragino Mincho ProN', serif" font-size="32" font-weight="500" fill="#fff">日</text>
</svg>
