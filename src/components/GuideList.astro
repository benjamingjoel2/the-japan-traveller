---
// Sticky list of guide pages (layout of the reference "tours" section):
// left, a sticky index with the active item in red; centre, square photos;
// right, the details for each photo. A small script highlights the item in
// view; without JS every row still shows its own details and link.
import Photo from './Photo.astro';
import { humanDate } from '../lib/dates.mjs';
interface Item { href: string; title: string; short: string; meta: string; text: string; image?: string; label: string; when: string; cta: string }
interface Props { items: Item[]; id?: string; eagerFirst?: boolean }
const { items, id = 'gl', eagerFirst = false } = Astro.props;
---
<div class="wrap stick" data-stick={id}>
  <ol class:list={["stick-list", items.length > 9 && "long"]} aria-label="Pages in this list">
    {items.map((it, i) => (
      <li><a href={`#${id}-${i}`} aria-current={i === 0 ? 'true' : undefined}>{it.short}<span class="d">{it.meta}</span></a></li>
    ))}
  </ol>
  {items.map((it, i) => (
    <div class="stick-item" id={`${id}-${i}`}>
      <div class="stick-img" data-i={i}><a href={it.href} tabindex="-1" aria-hidden="true">{it.image ? <Photo id={it.image} ratio={1} eager={eagerFirst && i === 0} widths={[400, 608, 900, 1216]} sizes="(max-width: 52rem) 100vw, 608px" /> : <span class="stick-ph"><span>{it.meta}</span><b>{it.short}</b></span>}</a></div>
      <div class="stick-info">
        <h3><a href={it.href} style="color:inherit;text-decoration:none">{it.title}</a></h3>
        <p class="label">{it.label}</p>
        <p class="when">{it.when}</p>
        <p>{it.text}</p>
        <a class="btn" href={it.href}>{it.cta}</a>
      </div>
    </div>
  ))}
</div>
<script is:inline define:vars={{ id }}>
  (function () {
    var root = document.querySelector('[data-stick="' + id + '"]');
    if (!root || !('IntersectionObserver' in window)) return;
    var links = root.querySelectorAll('.stick-list a');
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        var i = +e.target.getAttribute('data-i');
        links.forEach(function (l, j) { if (j === i) l.setAttribute('aria-current', 'true'); else l.removeAttribute('aria-current'); });
      });
    }, { rootMargin: '-45% 0px -45% 0px' });
    root.querySelectorAll('.stick-img').forEach(function (el) { io.observe(el); });
  })();
</script>
