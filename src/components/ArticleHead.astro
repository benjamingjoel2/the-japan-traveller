---
// Compatibility wrapper: pages that still call ArticleHead get the reference
// tour-page head (centred title, wide photo, meta row) via DetailHead.
import DetailHead from './DetailHead.astro';
interface Fact { icon?: string; label: string; value: string; href?: string }
interface Props { eyebrow?: string; ja?: string; title: string; dek?: string; image?: string; back?: unknown; facts?: Fact[]; card?: unknown }
const { title, dek, image, facts = [] } = Astro.props;
const meta = facts.slice(0, 3).map((f) => ({ label: f.label, value: f.value, href: f.href }));
---
<DetailHead title={title} lede={dek} image={image} meta={meta}><slot name="after" /></DetailHead>
