---
import Base from '../layouts/Base.astro';
import MonthList from '../components/MonthList.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { site, disclosure } from '../config/site.mjs';
import { publishedGuide, publishedQA } from '../lib/content.mjs';
import { publishedCompanies, feedMeta } from '../lib/feed.mjs';
import { NICHES, REGIONS, MONTHS, SEASON_EVENTS, RAIL_ROUTES, regionName } from '../data/reference.mjs';
import { destinationNode } from '../lib/schema.mjs';
import { humanDate } from '../lib/dates.mjs';

const guide = await publishedGuide();
const qa = await publishedQA();
const companies = publishedCompanies();
const feed = feedMeta();
const nowMonth = new Date().getUTCMonth() + 1;
const thisMonth = MONTHS.find((m) => m.n === nowMonth);
const KIND = { blossom: 'Blossom', leaves: 'Leaves', snow: 'Snow', festival: 'Festival', weather: 'Weather' };
const monthEvents = SEASON_EVENTS[nowMonth].slice(0, 5);
const count = (n) => (n.niche ? companies.filter((c) => c.niches.includes(n.niche)).length : companies.length);
const short = (d) => humanDate(d).replace(/ \d{4}$/, '');
const cardSizes = '(max-width: 36rem) 100vw, (max-width: 60rem) 50vw, 360px';
---
<Base title={site.name} description={site.positioning} path="/" jsonld={[destinationNode()]} bleed={true}>
  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <span class="badge"><Icon name="spark" />Sourced, dated, never paid</span>
        <h1 class="display">Plan Japan with a local. <span lang="ja"><span class="nw">地元の人と、</span><span class="nw">日本を旅する。</span></span></h1>
        <p class="dek">An independent reference for the regions, the seasons, rail and the Japan Rail Pass, ryokan etiquette, and which verified local operators deliver which kind of trip. Published by Tourground.</p>
        <div class="cta-row">
          <a class="btn btn-accent" href="/guide">Start with the guide</a>
          <a class="textlink" href="/how-we-rank">How we rank →</a>
        </div>
        <div class="hero-stats">
          <div><b>{REGIONS.length}</b><span>regions covered</span></div>
          <div><b>{RAIL_ROUTES.length}</b><span>rail routes timed</span></div>
          <div><b>{companies.length}</b><span>verified {companies.length === 1 ? 'operator' : 'operators'}</span></div>
        </div>
      </div>
      <Photo id="fuji-chureito" class="arch r-34" eager={true} ratio={3 / 4} widths={[400, 600, 860]} sizes="(max-width: 52rem) 100vw, 430px">Fujiyoshida · Yamanashi <span>Chureito Pagoda and Mount Fuji</span></Photo>
    </div>
  </section>

  <section class="section band-paper" id="guide">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Plan the trip · <span lang="ja">旅の計画</span></p>
          <h2>Six ways into Japan.</h2>
        </div>
        <p class="aside-note">Every page lists its sources and the date it was last reviewed.</p>
      </div>
      <ul class="tiles">
        {guide.map((g) => (
          <li class="tile">
            <a class="tile-link" href={`/guide/${g.id}`}>
              {g.data.image && <Photo id={g.data.image} ratio={4 / 3} sizes={cardSizes} />}
              <div class="tile-body">
                <p class="eyebrow">{g.data.nav ?? 'Guide'}{g.data.ja && <> · <span lang="ja">{g.data.ja}</span></>}</p>
                <h3>{g.data.title}</h3>
                <p>{g.data.description}</p>
                <div class="tile-meta"><span class="ico"><Icon name="sources" />{g.data.sources.length} sources</span><b>Reviewed {short(g.data.reviewed)}</b></div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band-dark" aria-labelledby="rank-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow-dark">How we rank · <span lang="ja">ランキングの基準</span></p>
          <h2 id="rank-h">Merit before money. Verified before listed.</h2>
        </div>
        <p class="dek">Every rank comes straight from the Tourground directory. We never reorder it, and no company can pay to change it.</p>
      </div>
      <ul class="fcards">
        <li class="fcard"><Icon name="scale" /><h3>Rank is merit, never paid</h3><p>Ranks are taken unchanged from the directory feed. Paid placements, when they exist, are labelled and kept apart.</p></li>
        <li class="fcard"><Icon name="shield" /><h3>Verified companies only</h3><p>Only companies the directory marks as verified are listed, plus Tourground's founder-owned brands, labelled every time.</p></li>
        <li class="fcard"><Icon name="sources" /><h3>Sources on every page</h3><p>Prices, journey times, entry rules and season windows carry a source and a last-reviewed date.</p></li>
      </ul>
    </div>
  </section>

  <section class="section band-cream" id="rankings">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Who to book with · <span lang="ja">旅行会社を選ぶ</span></p>
        <h2>Ranked lists, by kind of trip.</h2>
        <p class="dek">{disclosure.verifiedOnlyStatement} Feed dated {humanDate(feed.generated_at ?? '2026-11-02')}.</p>
        <a class="btn btn-accent" href="/rankings">All ranked lists</a>
      </div>
      <ol class="rows">
        {NICHES.map((n, i) => (
          <li><a href={`/rankings/${n.slug}`}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{n.title}</span>
            <span class="m">{count(n)} {count(n) === 1 ? 'operator' : 'operators'}</span>
          </a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="season-h">
    <div class="wrap wheel-wrap">
      <div>
        <p class="eyebrow">This month · <span lang="ja">{thisMonth.ja}</span></p>
        <h2 id="season-h" style="margin-top:0.75rem">Japan in {thisMonth.name}.</h2>
        <ul class="season-list">
          {monthEvents.map((e) => <li><span class="k">{KIND[e[1]]} · {regionName(e[0]).split(' ')[0]}</span><span>{e[2]}</span></li>)}
        </ul>
        <a class="btn btn-accent" href={`/seasons/${thisMonth.slug}`}>All of {thisMonth.name}</a>
      </div>
      <div>
        <p class="eyebrow">Month by month</p>
        <div style="margin-top:0.75rem"><MonthList current={nowMonth} /></div>
      </div>
    </div>
  </section>

  <section class="section band-cream" id="questions">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Good to know · <span lang="ja">知っておきたいこと</span></p>
        <h2>Questions before booking.</h2>
        <p class="dek">Short answer first, then the detail and the sources.</p>
        <a class="textlink" href="/questions">All questions →</a>
      </div>
      <ol class="rows plain">
        {qa.map((q) => (
          <li><a href={`/questions/${q.id}`}>
            <span class="t">{q.data.question}<small>{q.data.answer}</small></span>
          </a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band-accent">
    <div class="wrap">
      <h2>One reference. Every season.</h2>
      <p>Regions, rail, ryokan and the verified operators who deliver them, in one place.</p>
      <a class="btn btn-light" href="/guide">Start with the guide</a>
    </div>
  </section>
</Base>
