import Base from '../layouts/Base.astro';
import SeasonWheel from '../components/SeasonWheel.astro';
import { site, disclosure } from '../config/site.mjs';
import { publishedGuide, publishedQA } from '../lib/content.mjs';
import { publishedCompanies, feedMeta } from '../lib/feed.mjs';
import { NICHES, REGIONS } from '../data/reference.mjs';
import { destinationNode } from '../lib/schema.mjs';
import { humanDate } from '../lib/dates.mjs';

const guide = await publishedGuide();
const qa = await publishedQA();
const companies = publishedCompanies();
const feed = feedMeta();
const firstGuide = guide[0];
const firstQuestion = qa[0];
---
<Base title={site.name} description={site.positioning} path="/" jsonld={[destinationNode()]}>
  <section class="home-feature" aria-labelledby="home-title">
    <div class="home-feature-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span> THE JAPAN EDITION &nbsp;·&nbsp; TRAVEL, CONSIDERED</p>
      <h1 id="home-title">Go deeper<br />into <em>Japan.</em></h1>
      <p class="feature-dek">A thoughtful field guide to the places, seasons and small details that make a journey stay with you.</p>
      <div class="feature-meta"><span>THE ESSENTIAL GUIDE</span><span>UPDATED FOR 2026</span><span>12 REGIONS</span></div>
      <a class="button-link" href="/guide">EXPLORE THE GUIDE <span aria-hidden="true">↗</span></a>
    </div>
    <a class="home-feature-image" href="/guide/regions" aria-label="Explore Japan's regions">
      <img src="/images/kyoto-editorial.svg" alt="An illustrated lantern-lit Kyoto lane after the rain" fetchpriority="high" />
      <span class="image-caption"><span>01 / 12</span> KYOTO, AFTER THE RAIN</span>
    </a>
  </section>

  <section class="home-section home-latest" aria-labelledby="latest-title">
    <div class="section-heading">
      <div><p class="eyebrow">01 &nbsp;/&nbsp; THE FIELD NOTES</p><h2 id="latest-title">Start with the essentials.</h2></div>
      <a class="text-link" href="/guide">ALL FIELD NOTES <span aria-hidden="true">↗</span></a>
    </div>
    <div class="story-grid">
      {guide.slice(0, 3).map((g, i) => (
        <a class="story-card" href={`/guide/${g.id}`}>
          <span class="story-no">0{i + 1} <span>— FIELD GUIDE</span></span>
          <h3>{g.data.title}</h3><p>{g.data.description}</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section home-season" aria-labelledby="season-title">
    <div class="section-heading">
      <div><p class="eyebrow">02 &nbsp;/&nbsp; THE YEAR IN JAPAN</p><h2 id="season-title">Every season has its story.</h2></div>
      <a class="text-link" href="/seasons">EXPLORE ALL 12 MONTHS <span aria-hidden="true">↗</span></a>
    </div>
    <div class="season-editorial">
      <div class="season-note"><p>From the first plum blossoms to the quiet of snow country, discover when to go and where the moment is happening.</p><a class="button-link" href="/seasons">FIND YOUR SEASON <span aria-hidden="true">↗</span></a></div>
      <SeasonWheel />
    </div>
  </section>

  <section class="home-section home-discover" aria-labelledby="discover-title">
    <div class="section-heading">
      <div><p class="eyebrow">03 &nbsp;/&nbsp; FIND YOUR WAY</p><h2 id="discover-title">A country of many journeys.</h2></div>
    </div>
    <div class="discover-grid">
      <a href="/guide/regions" class="discover-card discover-regions"><span class="eyebrow">PLACE &nbsp;·&nbsp; {REGIONS.length} REGIONS</span><strong>Find your Japan.</strong><span>From northern wilderness to island south <b aria-hidden="true">↗</b></span></a>
      <a href="/rail-routes" class="discover-card discover-rail"><span class="eyebrow">GETTING AROUND &nbsp;·&nbsp; RAIL</span><strong>The long way<br />is the good way.</strong><span>Routes, times and pass coverage <b aria-hidden="true">↗</b></span></a>
      <a href="/questions" class="discover-card discover-questions"><span class="eyebrow">BEFORE YOU GO &nbsp;·&nbsp; {qa.length} ANSWERS</span><strong>Good to know.</strong><span>{firstQuestion?.data.question ?? 'Answers for the curious traveller'} <b aria-hidden="true">↗</b></span></a>
    </div>
  </section>

  <section class="home-section home-directory" aria-labelledby="directory-title">
    <div class="directory-copy"><p class="eyebrow">04 &nbsp;/&nbsp; LOCAL KNOW-HOW</p><h2 id="directory-title">Find the right people for your kind of trip.</h2><p>Independent, merit-based rankings from the Tourground directory. Every operator is listed for what they do best.</p><a class="button-link" href="/rankings">DISCOVER OPERATORS <span aria-hidden="true">↗</span></a></div>
    <div class="directory-side"><span class="directory-number">{feed.isMock ? '—' : companies.length.toString().padStart(2, '0')}</span><span class="eyebrow">{feed.isMock ? 'LIVE DIRECTORY COMING SOON' : 'VERIFIED LOCAL OPERATORS'}</span><a class="text-link" href="/how-we-rank">HOW WE RANK <span aria-hidden="true">↗</span></a></div>
  </section>
  <p class="home-disclosure">{disclosure.rankingStatement} <a href="/how-we-rank">Our ranking method</a>.</p>
</Base>
