---
import Base from '../layouts/Base.astro';
import SeasonWheel from '../components/SeasonWheel.astro';
import { site, disclosure } from '../config/site.mjs';
import { publishedGuide, publishedQA } from '../lib/content.mjs';
import { publishedCompanies, feedMeta } from '../lib/feed.mjs';
import { NICHES, REGIONS } from '../data/reference.mjs';
import { destinationNode } from '../lib/schema.mjs';
import { humanDate } from '../lib/dates.mjs';

const guide = await publishedGuide();
const qa = await publishedQA();
const companies = publishedCompanies();
const feed = feedMeta();
---
<Base title={site.name} description={site.positioning} path="/" jsonld={[destinationNode()]}>
  <h1>Planning Japan with a local operator: the reference</h1>
  <p class="dek">{site.name} is an independent reference for travellers planning Japan: the regions, the seasons, rail and the Japan Rail Pass, ryokan etiquette, and which verified local operators deliver which kind of trip. It is published by Tourground. Rankings come only from the Tourground directory and are never paid for.</p>

  <h2>Japan at a glance</h2>
  <dl class="glance">
    <div><dt>Regions</dt><dd>{REGIONS.length} for planning: {REGIONS.map((r) => r.name).join(', ')}. <a href="/guide/regions">Regions guide</a></dd></div>
    <div><dt>Seasons</dt><dd>Cherry blossom late March to May (south to north); rainy season June to July; autumn leaves October to early December; snow December to March. <a href="/seasons">Season wheel</a></dd></div>
    <div><dt>Rail</dt><dd>Shinkansen from Kagoshima to Hokkaido. 7-day Japan Rail Pass ¥50,000 online (adult, ordinary). <a href="/rail-routes">Rail-route table</a></dd></div>
    <div><dt>Entry</dt><dd>Visa-free short stays (90 days for most exempt nationalities, including US, UK, EU and Brazil). Departure tax ¥3,000 from 1 July 2026. <a href="/guide/entry-basics">Entry basics</a></dd></div>
    <div><dt>Operators listed</dt><dd>{feed.isMock ? 'Live directory listings are not available in this build.' : <><span class="mono">{companies.length}</span> verified or founder-owned {companies.length === 1 ? 'operator' : 'operators'} in the Tourground directory feed of {feed.generated_at ? humanDate(feed.generated_at) : 'the current build'}. <a href="/operators">All operators</a></>}</dd></div>
  </dl>

  <h2>Explore the year</h2>
  <div class="wheel-wrap">
    <SeasonWheel />
    <div class="prose">
      <p>Pick a month on the wheel to see what is happening in each region (blossom, leaves, snow and festivals) and which verified operators run trips that month.</p>
      <ul class="legend" aria-label="Wheel legend">
        <li><i style="background:#b0476a"></i>Blossom</li>
        <li><i style="background:#9a5a10"></i>Leaves</li>
        <li><i style="background:#2c4d7c"></i>Snow</li>
        <li><i style="background:#1b1b1a"></i>Festival</li>
      </ul>
      <p><a href="/seasons">Open the season guide</a></p>
    </div>
  </div>

  <h2>Destination guide</h2>
  <ol class="index">
    {guide.map((g, i) => (
      <li><span class="no">{String(i + 1).padStart(2, '0')}</span><div><a href={`/guide/${g.id}`}>{g.data.title}</a><p>{g.data.description}</p></div></li>
    ))}
    <li><span class="no">{String(guide.length + 1).padStart(2, '0')}</span><div><a href="/rail-routes">Rail-route table</a><p>Classic routes with typical journey times and Japan Rail Pass coverage, sourced and dated.</p></div></li>
  </ol>

  <h2>Ranked lists</h2>
  <p class="note">{disclosure.rankingStatement} <a href="/how-we-rank">How we rank</a>.</p>
  <ol class="index">
    {NICHES.map((n, i) => (
      <li><span class="no">{String(i + 1).padStart(2, '0')}</span><div><a href={`/rankings/${n.slug}`}>{n.title}</a><p>{n.blurb}</p></div></li>
    ))}
  </ol>

  <h2>Traveller questions</h2>
  <ol class="index">
    {qa.map((q, i) => (
      <li><span class="no">Q{i + 1}</span><div><a href={`/questions/${q.id}`}>{q.data.question}</a><p>{q.data.answer}</p></div></li>
    ))}
  </ol>
</Base>
