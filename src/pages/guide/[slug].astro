---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHead from '../../components/ArticleHead.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import CtaBand from '../../components/CtaBand.astro';
import Sources from '../../components/Sources.astro';
import RailTable from '../../components/RailTable.astro';
import MonthList from '../../components/MonthList.astro';
import { publishedGuide } from '../../lib/content.mjs';
import { humanDate } from '../../lib/dates.mjs';
import { articleNode, destinationNode } from '../../lib/schema.mjs';

export async function getStaticPaths() {
  const entries = await publishedGuide();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/guide/${entry.id}`;
const others = all.filter((g) => g.id !== entry.id).map((g) => ({ href: `/guide/${g.id}`, label: g.data.title }));
---
<Base title={d.title} description={d.description} path={path} bleed={true}
  crumbs={[{ name: 'Guide', href: '/guide' }, { name: d.nav ?? d.title, href: path }]}
  jsonld={[articleNode({ title: d.title, description: d.description, path, published: d.published, reviewed: d.reviewed, sources: d.sources }), entry.id === 'regions' ? destinationNode() : null]}>
  <article>
    <ArticleHead back={{ href: '/guide', label: 'All guides' }} eyebrow={d.nav ?? 'Guide'} ja={d.ja} title={d.title} dek={d.description} image={d.image}
      facts={[
        { icon: 'calendar', label: 'Last reviewed', value: humanDate(d.reviewed) },
        { icon: 'sources', label: 'Sources', value: `${d.sources.length} listed`, href: '#sources' },
        { icon: 'book', label: 'Published', value: humanDate(d.published) },
        { icon: 'map', label: 'Covers', value: 'Japan' },
      ]}
      card={{ label: 'Book with a local', value: 'Ranked operators', href: '/rankings', cta: 'See the lists' }} />
    <div class="band-paper">
      {d.embed === 'month-list' && (
        <div class="wrap" style="padding-top:clamp(3rem,6vw,5rem)"><div class="wheel-wrap"><p class="dek">Pick a month to see each region in that month, with the operators who run trips then.</p><MonthList /></div></div>
      )}
      <div class="wrap article-body">
        <ArticleAside published={d.published} reviewed={d.reviewed} sourceCount={d.sources.length} links={[...others, { href: '/rail-routes', label: 'Rail-route table' }, { href: '/seasons', label: 'Month by month' }]} linksTitle="More in the guide" />
        <div>
          <div class="prose"><Content /></div>
          {d.embed === 'rail-table' && <RailTable />}
          <Sources sources={d.sources} />
        </div>
      </div>
    </div>
  </article>
  <CtaBand title="Ready to plan the trip?" text="See which verified local operators deliver this kind of trip, ranked only by merit." href="/rankings" cta="Browse ranked lists" />
</Base>
