---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import Sources from '../../components/Sources.astro';
import RailTable from '../../components/RailTable.astro';
import SeasonWheel from '../../components/SeasonWheel.astro';
import { publishedGuide } from '../../lib/content.mjs';
import { articleNode, destinationNode } from '../../lib/schema.mjs';

export async function getStaticPaths() {
  const entries = await publishedGuide();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/guide/${entry.id}`;
---
<Base title={d.title} description={d.description} path={path}
  crumbs={[{ name: 'Guide', href: '/guide' }, { name: d.nav ?? d.title, href: path }]}
  jsonld={[articleNode({ title: d.title, description: d.description, path, published: d.published, reviewed: d.reviewed, sources: d.sources }), entry.id === 'regions' ? destinationNode() : null]}>
  <article>
    <h1>{d.title}</h1>
    <p class="dek">{d.description}</p>
    <PageMeta published={d.published} reviewed={d.reviewed} sourceCount={d.sources.length} />
    {d.embed === 'season-wheel' && (
      <div class="wheel-wrap"><SeasonWheel /><p class="note">Pick a month to see each region in that month.</p></div>
    )}
    <div class="prose"><Content /></div>
    {d.embed === 'rail-table' && <RailTable />}
    <Sources sources={d.sources} />
  </article>
</Base>
