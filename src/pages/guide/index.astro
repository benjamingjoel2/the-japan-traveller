---
import Base from '../../layouts/Base.astro';
import DetailHead from '../../components/DetailHead.astro';
import GuideList from '../../components/GuideList.astro';
import { publishedGuide } from '../../lib/content.mjs';
import { destinationNode } from '../../lib/schema.mjs';
import { humanDate } from '../../lib/dates.mjs';
import { RAIL_ROUTES } from '../../data/reference.mjs';
const guide = await publishedGuide();
const title = 'Japan destination guide';
const description = 'Regions, seasons, rail and the Japan Rail Pass, ryokan and onsen, typical 7, 10 and 14-day routes, and entry basics for Japan.';
const items = guide.map((g) => ({ href: `/guide/${g.id}`, title: g.data.title, short: g.data.nav ?? g.data.title, meta: `${g.data.sources.length} sources`, text: g.data.description, image: g.data.image, label: 'Last reviewed', when: humanDate(g.data.reviewed), cta: 'Read the guide' }));
items.push({ href: '/rail-routes', title: 'Rail-route table', short: 'Rail routes', meta: `${RAIL_ROUTES.length} routes`, text: 'Classic routes, typical journey times and Japan Rail Pass coverage.', image: 'shinkansen-motion', label: 'Routes timed', when: `${RAIL_ROUTES.length} classic routes`, cta: 'Open the table' });
items.push({ href: '/seasons', title: 'Month by month', short: 'Month by month', meta: '12 months', text: 'Blossom, leaves, snow and festivals in each region, month by month.', image: 'autumn-maple', label: 'Covers', when: '12 months, 9 regions', cta: 'Pick a month' });
---
<Base title={title} description={description} path="/guide" crumbs={[{ name: 'Guide', href: '/guide' }]} jsonld={[destinationNode()]} bleed={true}>
  <DetailHead title={title} lede={`${description} Each page lists its sources and the date it was last reviewed.`} image="fuji-blossom"
    meta={[{ label: 'Guide pages', value: String(guide.length) }, { label: 'Rail routes', value: String(RAIL_ROUTES.length) }, { label: 'Regions', value: '9' }]} />
  <section class="section">
    <h2 class="sr-only">Guide pages</h2>
    <GuideList items={items} id="guide-index" />
  </section>
</Base>
