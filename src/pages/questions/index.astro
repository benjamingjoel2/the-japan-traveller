---
import Base from '../../layouts/Base.astro';
import DetailHead from '../../components/DetailHead.astro';
import { publishedQA } from '../../lib/content.mjs';
import { faqNode } from '../../lib/schema.mjs';
const qa = await publishedQA();
const title = 'Traveller questions about Japan';
const description = 'Real questions travellers ask when planning Japan, each answered briefly first and then in detail, with sources.';
---
<Base title={title} description={description} path="/questions" crumbs={[{ name: 'Questions', href: '/questions' }]} bleed={true}
  jsonld={[faqNode(qa.map((q) => ({ question: q.data.question, answer: q.data.answer })))]}>
  <DetailHead title="Frequently Asked Questions" lede={description} />
  <section class="section band-sand" style="margin-top:clamp(2rem,4vw,3rem)">
    <div class="wrap faq">
      <h2>Short answers first.</h2>
      <div class="acc">
        {qa.map((q, i) => (
          <details open={i === 0}>
            <summary>{q.data.question}</summary>
            <div class="a"><p>{q.data.answer}</p><a class="btn btn-ghost" href={`/questions/${q.id}`}>Read the full answer</a></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
