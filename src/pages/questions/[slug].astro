---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHead from '../../components/ArticleHead.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import Sources from '../../components/Sources.astro';
import { publishedQA } from '../../lib/content.mjs';
import { articleNode, faqNode } from '../../lib/schema.mjs';

export async function getStaticPaths() {
  const all = await publishedQA();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/questions/${entry.id}`;
const related = d.related.map((id) => all.find((q) => q.id === id)).filter(Boolean);
---
<Base title={d.title} description={d.description} path={path} bleed={true}
  crumbs={[{ name: 'Questions', href: '/questions' }, { name: d.title, href: path }]}
  jsonld={[faqNode([{ question: d.question, answer: d.answer }]), articleNode({ title: d.title, description: d.description, path, published: d.published, reviewed: d.reviewed, sources: d.sources })]}>
  <article>
    <ArticleHead eyebrow="Traveller question" title={d.question} image={d.image}>
      <div slot="after" class="answer"><span class="label">Short answer</span><p>{d.answer}</p></div>
    </ArticleHead>
    <div class="wrap article-body">
      <ArticleAside published={d.published} reviewed={d.reviewed} sourceCount={d.sources.length}
        links={related.map((q) => ({ href: `/questions/${q.id}`, label: q.data.question }))} linksTitle="Related questions" />
      <div>
        <div class="prose"><Content /></div>
        <Sources sources={d.sources} />
      </div>
    </div>
  </article>
</Base>
