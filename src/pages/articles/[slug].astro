---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DetailHead from '../../components/DetailHead.astro';
import ArticleLayout from '../../components/ArticleLayout.astro';
import FactsPanel from '../../components/FactsPanel.astro';
import Sources from '../../components/Sources.astro';
import { publishedArticles } from '../../lib/content.mjs';
import { humanDate } from '../../lib/dates.mjs';
import { articleNode } from '../../lib/schema.mjs';

export async function getStaticPaths() {
  const all = await publishedArticles();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const path = `/articles/${entry.id}`;
const rows = headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, title: h.text }));
const next = all[(all.findIndex((a) => a.id === entry.id) + 1) % all.length];
---
<Base title={d.title} description={d.description} path={path} bleed={true}
  crumbs={[{ name: 'Articles', href: '/articles' }, { name: d.title, href: path }]}
  jsonld={[articleNode({ title: d.title, description: d.description, path, published: d.published, reviewed: d.reviewed, sources: d.sources })]}>
  <article>
    <DetailHead title={d.title} image={d.image}
      meta={[d.newsDate ? { label: 'News from', value: humanDate(d.newsDate) } : { label: d.region ? 'Region' : 'Category', value: d.region ?? d.category }, { label: 'Last reviewed', value: humanDate(d.reviewed) }, { label: 'Sources', value: `${d.sources.length} listed`, href: '#sources' }]} />
    <section class="section-sm">
      <div class="wrap statement2"><h2>{d.description}</h2><p>{d.newsDate ? `News reported on ${humanDate(d.newsDate)}, rewritten for travellers and checked against the sources listed at the end.` : `${d.category}. Every figure in this article comes from the sources listed at the end, checked on the date shown.`}</p></div>
    </section>
    <ArticleLayout published={d.published} reviewed={d.reviewed} sourceCount={d.sources.length} rows={rows} newsDate={d.newsDate}>
      <div class="prose"><Content /></div>
      <Sources sources={d.sources} />
    </ArticleLayout>
  </article>
  {next && next.id !== entry.id && <FactsPanel image={next.data.image} cta={{ href: `/articles/${next.id}`, label: 'Next article' }}
    facts={[{ label: 'Next article', value: next.data.title, href: `/articles/${next.id}` }, { label: 'In short', value: next.data.description }, { label: 'Ready to book?', value: 'See the ranked lists of verified operators', href: '/rankings' }]} />}
</Base>
