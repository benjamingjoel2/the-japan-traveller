---
import '../styles/global.css';
import { site, disclosure } from '../config/site.mjs';
import { graph, websiteNode, publisherNode, breadcrumbNode, abs } from '../lib/schema.mjs';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  jsonld?: object[];
  ogType?: string;
  noindex?: boolean;
  /** full-bleed layout: the page provides its own .wrap sections */
  bleed?: boolean;
}
const { title, description, path, crumbs = [], jsonld = [], ogType = 'article', noindex = false, bleed = false } = Astro.props;
const canonical = abs(path);
const isHome = path === '/';
const fullTitle = isHome ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const allCrumbs = isHome ? [] : [{ name: 'Home', href: '/' }, ...crumbs];
const ld = graph(
  websiteNode(),
  isHome ? publisherNode() : null,
  allCrumbs.length ? breadcrumbNode(allCrumbs) : null,
  ...jsonld,
);
const nav = [
  { href: '/guide', label: 'Guide' },
  { href: '/seasons', label: 'Seasons' },
  { href: '/rail-routes', label: 'Rail' },
  { href: '/rankings', label: 'Rankings' },
  { href: '/operators', label: 'Operators' },
  { href: '/questions', label: 'Questions' },
  { href: '/compare', label: 'Compare' },
];
const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const nowMonth = MONTH_NAMES[new Date().getUTCMonth()];
const section = '/' + path.split('/')[1];
const styleVars = `:root{--accent:${site.colors.accent};--accent-dark:${site.colors.accentOnDark}}`;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/shippori-mincho-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zen-kaku-gothic-new-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#1e3557" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={isHome ? 'website' : ogType} />
    <meta property="og:title" content={isHome ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={`${site.url}/og/default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <style set:html={styleVars}></style>
    <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="ticker">
      <div class="wrap">
        <span><i aria-hidden="true">●</i> {disclosure.footerPublishedBy} Rankings are never paid.</span>
        <a href={`/seasons/${nowMonth.toLowerCase()}`}>This month: {nowMonth} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <header class="bar">
      <div class="wrap bar-in">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={section === n.href ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="btn btn-solid bar-cta" href="/how-we-rank">How we rank <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      {allCrumbs.length > 0 && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <ol>
            {allCrumbs.map((c, i) => (
              <li>{i === allCrumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      {bleed ? <slot /> : <div class="wrap page"><slot /></div>}
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <p class="eyebrow eyebrow-dark"><i aria-hidden="true">●</i> About this site</p>
            <p>{disclosure.footerShort}</p>
            <p>{site.editorLine}</p>
          </div>
          <div>
            <p class="eyebrow eyebrow-dark">Plan</p>
            <ul>
              <li><a href="/guide">Destination guide</a></li>
              <li><a href="/seasons">Season wheel</a></li>
              <li><a href="/rail-routes">Rail-route table</a></li>
              <li><a href="/questions">Questions</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow eyebrow-dark">Operators</p>
            <ul>
              <li><a href="/rankings">Ranked lists</a></li>
              <li><a href="/operators">All operators</a></li>
              <li><a href="/compare">Compare</a></li>
              <li><a href="/how-we-rank">How we rank</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow eyebrow-dark">This site</p>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="/disclosure">Publisher disclosure</a></li>
              <li><a href="/corrections">Corrections and removal</a></li>
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms">Terms</a></li>
              <li><a href="/cookies">Cookie Policy</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow eyebrow-dark">Contact</p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            <address>{site.address.lines.map((l) => <>{l}<br /></>)}</address>
          </div>
        </div>
        <p class="foot-mark" aria-hidden="true">{site.name}</p>
        <div class="foot-base">
          <p class="pub">{disclosure.footerPublishedBy.replace('Tourground.', '')}<a href={site.publisher.url}>Tourground</a>.</p>
          <p>{site.domain}</p>
        </div>
      </div>
    </footer>
    {site.analytics.vercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </body>
</html>
