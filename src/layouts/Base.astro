---
import '../styles/global.css';
import { site, disclosure } from '../config/site.mjs';
import { graph, websiteNode, publisherNode, breadcrumbNode, abs } from '../lib/schema.mjs';
import Seal from '../components/Seal.astro';
import Photo from '../components/Photo.astro';
import { publishedGuide } from '../lib/content.mjs';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  jsonld?: object[];
  ogType?: string;
  noindex?: boolean;
  /** full-bleed layout: the page provides its own .wrap sections */
  bleed?: boolean;
}
const { title, description, path, crumbs = [], jsonld = [], ogType = 'article', noindex = false, bleed = false } = Astro.props;
const canonical = abs(path);
const isHome = path === '/';
const fullTitle = isHome ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const allCrumbs = isHome ? [] : [{ name: 'Home', href: '/' }, ...crumbs];
const ld = graph(
  websiteNode(),
  isHome ? publisherNode() : null,
  allCrumbs.length ? breadcrumbNode(allCrumbs) : null,
  ...jsonld,
);
const nav = [
  { href: '/guide', label: 'Guide' },
  { href: '/seasons', label: 'Months' },
  { href: '/articles', label: 'Articles' },
  { href: '/rankings', label: 'Rankings' },
  { href: '/questions', label: 'FAQ' },
];
const guide = await publishedGuide();

const section = '/' + path.split('/')[1];
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/shippori-mincho-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={isHome ? 'website' : ogType} />
    <meta property="og:title" content={isHome ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={`${site.url}/og/default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  </head>
  <body class:list={[isHome && 'home']}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="wrap bar-in">
        <a class="brand" href="/"><Seal /><span class="wm"><b>THE JAPAN</b> <small>TRAVELLER</small></span></a>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={section === n.href ? 'page' : undefined}>{n.label}</a></li>)}
            <li><a class="lang" href="/how-we-rank">How we rank</a></li>
          </ul>
        </nav>
        <details class="menu">
          <summary aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg></summary>
          <div class="menu-panel">
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              <li><a href="/operators">Operators</a></li>
              <li><a href="/how-we-rank">How we rank</a></li>
            </ul>
          </div>
        </details>
      </div>
    </header>

    <main id="main">
      {allCrumbs.length > 0 && !bleed && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <ol>
            {allCrumbs.map((c, i) => (
              <li>{i === allCrumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      {bleed ? <slot /> : <div class="wrap page"><slot /></div>}
    </main>

    <footer class="foot">
      <Photo id="kamikochi" sizes="100vw" widths={[640, 1024, 1600]} />
      <div class="foot-card">
        <a class="foot-logo" href="/"><Seal /><b>THE JAPAN</b><small>TRAVELLER</small></a>
        <div class="foot-cols">
          <div>
            <h2>Menu</h2>
            <ul>
              <li><a href="/guide">Guide</a></li>
              <li><a href="/seasons">Month by month</a></li>
              <li><a href="/rail-routes">Rail routes</a></li>
              <li><a href="/articles">Articles</a></li>
              <li><a href="/questions">Questions</a></li>
            </ul>
          </div>
          <div>
            <h2>Guide</h2>
            <ul>{guide.map((g) => <li><a href={`/guide/${g.id}`}>{g.data.nav ?? g.data.title}</a></li>)}</ul>
          </div>
          <div>
            <h2>Operators</h2>
            <ul>
              <li><a href="/rankings">Ranked lists</a></li>
              <li><a href="/operators">All operators</a></li>
              <li><a href="/compare">Compare</a></li>
              <li><a href="/how-we-rank">How we rank</a></li>
            </ul>
          </div>
          <div>
            <h2>About</h2>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="/disclosure">Disclosure</a></li>
              <li><a href="/corrections">Corrections</a></li>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/terms">Terms</a></li>
              <li><a href="/cookies">Cookies</a></li>
            </ul>
          </div>
          <div>
            <h2>Contact</h2>
            <address><a href={`mailto:${site.email}`}>{site.email}</a><br /><br />{site.address.lines.map((l) => <>{l}<br /></>)}</address>
          </div>
        </div>
        <p class="foot-base">© {new Date().getUTCFullYear()} {site.name}. {disclosure.footerPublishedBy.replace('Tourground.', '')}<a href={site.publisher.url}>Tourground</a>. {disclosure.footerShort.replace('An independent reference published by Tourground. ', '')}</p>
      </div>
    </footer>
    {site.analytics.vercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </body>
</html>
