---
import '../styles/global.css';
import { site, disclosure } from '../config/site.mjs';
import { graph, websiteNode, publisherNode, breadcrumbNode, abs } from '../lib/schema.mjs';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  jsonld?: object[];
  ogType?: string;
  noindex?: boolean;
  /** full-bleed layout: the page provides its own .wrap sections */
  bleed?: boolean;
}
const { title, description, path, crumbs = [], jsonld = [], ogType = 'article', noindex = false, bleed = false } = Astro.props;
const canonical = abs(path);
const isHome = path === '/';
const fullTitle = isHome ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const allCrumbs = isHome ? [] : [{ name: 'Home', href: '/' }, ...crumbs];
const ld = graph(
  websiteNode(),
  isHome ? publisherNode() : null,
  allCrumbs.length ? breadcrumbNode(allCrumbs) : null,
  ...jsonld,
);
const nav = [
  { href: '/guide', label: 'Guide' },
  { href: '/seasons', label: 'Seasons' },
  { href: '/rail-routes', label: 'Rail' },
  { href: '/operators', label: 'Operators' },
  { href: '/questions', label: 'Questions' },
];

const section = '/' + path.split('/')[1];
const styleVars = `:root{--accent:${site.colors.accent};--accent-dark:${site.colors.accentOnDark}}`;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/noto-sans-jp-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-jp-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-jp-ja-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f6f0e4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={isHome ? 'website' : ogType} />
    <meta property="og:title" content={isHome ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={`${site.url}/og/default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <style set:html={styleVars}></style>
    <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="wrap bar-in">
        <a class="brand" href="/"><b>{site.name}</b><small>Independent Japan travel reference</small></a>
        <div class="nav-wrap">
          <nav class="nav" aria-label="Main">
            <ul>
              {nav.map((n) => (
                <li><a href={n.href} aria-current={section === n.href ? 'page' : undefined}>{n.label}</a></li>
              ))}
            </ul>
          </nav>
          <a class="btn btn-accent bar-cta" href="/rankings">Ranked<span class="hide-sm">operators</span></a>
        </div>
      </div>
    </header>

    <main id="main">
      {allCrumbs.length > 0 && !bleed && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <ol>
            {allCrumbs.map((c, i) => (
              <li>{i === allCrumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      {bleed ? <slot /> : <div class="wrap page"><slot /></div>}
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-top">
          <div>
            <p class="eyebrow eyebrow-dark">Published by Tourground · <span lang="ja">発行</span></p>
            <h2>A reference for planning Japan with a local operator.</h2>
            <p>{disclosure.footerShort}</p>
            <p>{site.editorLine}</p>
          </div>
          <div class="foot-links">
            <ul>
              <li><a href="/guide">Destination guide</a></li>
              <li><a href="/seasons">Month by month</a></li>
              <li><a href="/rail-routes">Rail-route table</a></li>
              <li><a href="/questions">Questions</a></li>
              <li><a href="/rankings">Ranked lists</a></li>
              <li><a href="/operators">Operators</a></li>
              <li><a href="/compare">Compare</a></li>
            </ul>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="/how-we-rank">How we rank</a></li>
              <li><a href="/disclosure">Publisher disclosure</a></li>
              <li><a href="/corrections">Corrections and removal</a></li>
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms">Terms</a></li>
              <li><a href="/cookies">Cookie Policy</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-mid">
          <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
          <address>{site.address.lines.join(', ')}</address>
        </div>
        <div class="foot-base">
          <p class="pub">{disclosure.footerPublishedBy.replace('Tourground.', '')}<a href={site.publisher.url}>Tourground</a>.</p>
          <small>{site.name} · {site.domain}</small>
        </div>
      </div>
    </footer>
    {site.analytics.vercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </body>
</html>
